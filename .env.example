# Amazon 監視対象 URL
PRODUCT_URL=https://www.amazon.co.jp/baby-reg/welcomebox?ref_=br_dsk_hp_bene_wb

# チェック間隔（秒）
CHECK_INTERVAL=300

# 在庫あり判定用キーワード（カンマ区切り）
IN_STOCK_KEYWORDS=条件を達成すると申請できます,今すぐもらう,カートに入れる

# 在庫なし判定用キーワード（カンマ区切り）
OUT_OF_STOCK_KEYWORDS=現在在庫切れです,一時的に在庫切れ,現在お申し込みいただけません

# SMTP 設定
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=you@example.com
TO_EMAIL=dest@example.com

# 任意: User-Agent を指定（Amazon は UA によって表示が変わるため）
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)
